# Papermerge DMS — reference dev environment.
#
# Usage:
#   1) cp .env.dev .env
#   2) edit SECRET_KEY / ADMIN_PASSWORD / POSTGRES_PASSWORD for your setup
#   3) docker compose up -d --build
#
# .env is in .gitignore — never commit it. This file (.env.dev) is the
# committed reference; docker compose reads ONLY .env at runtime.

# --- Timezone (UTC+10, Khabarovsk / Vladivostok) ---------------------------
# Used by every container for wall clock / logs / cron. IANA name, not offset.
TZ=Asia/Vladivostok
# PostgreSQL session TimeZone for TIMESTAMP WITHOUT TIME ZONE columns.
# Must be UTC so DB func.now() matches app UTC writes; UI always shows TZ above.
PGTZ=UTC
PAPERMERGE__MAIN__TIMEZONE=Asia/Vladivostok

# --- Security ---------------------------------------------------------------
# Shared secret used by the auth server and the core API. Must be the same
# value for both (they live inside the same container in monolithic mode).
# Regenerate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# --- Public HTTP port -------------------------------------------------------
# Host port mapped to nginx:80 inside the app container.
APP_PORT=12000

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=papermerge
POSTGRES_PASSWORD=papermerge
POSTGRES_DB=papermerge

# --- First-boot superuser ---------------------------------------------------
# Created automatically on the first `docker compose up`. Also receives the
# "admin" role (full permissions) so the UI is ready to use immediately.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com

# --- Full-text search (Solr via salinic) -------------------------------------
# Docker Compose sets PAPERMERGE__SEARCH__URL=solr://solr:8983/papermerge
# inside app/index_worker (see docker-compose.yml). Do not put 127.0.0.1 here
# unless you only run native backend (run-dev-native.bat sets it in the shell).

# --- Public library catalog (optional) ---------------------------------------
# UUID of the folder used as the guest browse root. When unset, bootstrap uses
# the admin user's home folder (see `paper-cli library init-catalog`).
# PAPERMERGE__LIBRARY__CATALOG_ROOT_NODE_ID=

# --- Native backend + frontend (`run-dev-native.bat`) ------------------------
# Docker Postgres is published on localhost:5432. The core API reads this via
# `.env` (pydantic-settings) so `fastapi dev` reload children still connect
# correctly on Windows.
PAPERMERGE__DATABASE__URL=postgresql://papermerge:papermerge@127.0.0.1:5432/papermerge
PAPERMERGE__REDIS__URL=redis://127.0.0.1:6379/0
PAPERMERGE__MAIN__API_PREFIX=/api
PAPERMERGE__MAIN__MEDIA_ROOT=media
PAPERMERGE__SEARCH__URL=solr://127.0.0.1:8983/papermerge
PAPERMERGE__DEV__AUTH_BYPASS_ENABLED=true
PAPERMERGE__DEV__AUTH_BYPASS_USERNAME=admin

# Native frontend dev (Vite on :15173) — set when running `poetry run task server`
# without run-dev-native.bat so cross-origin API calls still work.
# PAPERMERGE__MAIN__CORS_ORIGINS=http://127.0.0.1:15173,http://localhost:15173

# DOCX uploads are converted to PDF via Gotenberg (docker compose service on :3000).
# Native backend: docker compose up -d gotenberg and set:
# PAPERMERGE__MAIN__GOTENBERG_URL=http://127.0.0.1:3000
# Gotenberg LibreOffice flags are set in docker-compose.yml (--libreoffice-start-timeout).
# On slow hosts increase GOTENBERG_MEM_LIMIT (e.g. 2G).

# --- Production / ops (docker compose) ---------------------------------------
# Docker log rotation for every service (json-file driver).
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# Resource limits (cpus / memory). Defaults target Docker Desktop with ~4–6 GB
# RAM for the Linux VM (sum of limits ≈ 4.1 GB). On a beefier host, raise them:
# DB_CPU_LIMIT=2
# DB_MEM_LIMIT=2G
# REDIS_CPU_LIMIT=0.5
# REDIS_MEM_LIMIT=512M
# REDIS_MAXMEMORY=384mb
# APP_CPU_LIMIT=2
# APP_MEM_LIMIT=2G
# GOTENBERG_CPU_LIMIT=1
# GOTENBERG_MEM_LIMIT=1G
# SOLR_CPU_LIMIT=1.5
# SOLR_MEM_LIMIT=2G
# SOLR_JAVA_MEM=-Xms512m -Xmx1536m
# On Linux servers do not set SOLR_MEM_LIMIT below 2G: cgroups enforce it
# (Docker Desktop on Windows is more forgiving). Heap must stay under the limit.
# INDEX_WORKER_CPU_LIMIT=1
# INDEX_WORKER_MEM_LIMIT=1G
# INDEX_WORKER_CONCURRENCY=2

# Automated backups (backup service). Files land in ./backups/ (git-ignored).
# Cron format: minute hour day month weekday (container TZ).
BACKUP_SCHEDULE_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=14
# Media tar on Windows bind mounts is I/O-heavy — keep false for localhost prod.
BACKUP_MEDIA=false
BACKUP_MEDIA_RETENTION_DAYS=30
# Set true to run one dump immediately on `docker compose up`.
BACKUP_RUN_ON_START=false

# --- Production on localhost (checklist) -------------------------------------
# 1) cp .env.dev .env and edit secrets (never use defaults in production):
#      python -c "import secrets; print(secrets.token_hex(32))"  # SECRET_KEY
#      set strong ADMIN_PASSWORD and POSTGRES_PASSWORD
# 2) Docker Desktop → Settings → Resources:
#      Memory: at least 6 GB (8 GB recommended for Solr + Gotenberg)
#      CPUs: at least 4 if you raise compose limits above defaults
#      Disk image location: prefer a drive with free space (not a nearly-full C:)
# 3) In .env for docker compose, REMOVE or comment out dev-only native vars:
#      PAPERMERGE__DEV__AUTH_BYPASS_ENABLED
#      PAPERMERGE__DEV__AUTH_BYPASS_USERNAME
#    (Compose overrides DB/Redis/Search URLs inside containers — host URLs are
#     only for run-dev-native.bat.)
# 4) APP_PORT=80 (or 12000 if port 80 is taken).
# 5) docker compose down && docker compose up -d --build
#    If build fails on env2js download: save
#    https://github.com/papermerge/env2js/releases/download/0.2/env2js.amd64
#    as docker/app/bin/env2js.amd64 and rebuild.
# 6) Open http://localhost:<APP_PORT>/ — login with ADMIN_USERNAME / ADMIN_PASSWORD
# 7) If the stack feels slow after days of uptime: `docker compose restart`
#    or restart Docker Desktop (WSL2 VM memory fragmentation on Windows).
