# Force LF line endings for files that must run inside Linux containers or
# otherwise break on Windows CRLF. This avoids "exec format error" and similar
# surprises when developers edit files on Windows.
*.sh          text eol=lf
Dockerfile    text eol=lf
*.Dockerfile  text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.conf        text eol=lf
.env*         text eol=lf

# Mark binary fixtures so git does not try to detect their encoding.
*.pdf         binary
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.woff        binary
*.woff2       binary
